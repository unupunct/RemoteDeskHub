<UserControl x:Class="RemoteDeskHub.Desktop.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding Accent, ElementName=Root}" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,1" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
