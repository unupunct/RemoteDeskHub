<Window x:Class="RemoteDeskHub.Desktop.Services.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteDesk Hub"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="AccentBar" Width="4" Height="22" CornerRadius="2"
                        Background="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Body}"
                       Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Click="Cancel_Click" Visibility="Collapsed" IsCancel="True" />
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
