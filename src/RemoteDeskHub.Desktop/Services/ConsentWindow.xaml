<Window x:Class="RemoteDeskHub.Desktop.Services.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm remote session"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="Heading" Style="{StaticResource H2}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Body}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Padding="12" Margin="0,16,0,0">
                <CheckBox x:Name="ConsentCheck" Style="{StaticResource AppCheckBox}" Checked="ConsentCheck_Changed"
                          Unchecked="ConsentCheck_Changed" Content="I confirm that the person at the target computer has explicitly consented to this session." />
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <TextBlock Text="This action is audited." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="LaunchButton" Content="Launch session" Style="{StaticResource PrimaryButton}"
                        IsEnabled="False" Click="Launch_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
