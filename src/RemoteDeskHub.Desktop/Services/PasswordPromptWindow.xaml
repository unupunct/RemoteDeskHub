<Window x:Class="RemoteDeskHub.Desktop.Services.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Style="{StaticResource Card}" Margin="14" Padding="20">
        <StackPanel>
            <TextBlock x:Name="LabelText" Style="{StaticResource Body}" Margin="0,0,0,10" />
            <PasswordBox x:Name="ValueBox" Style="{StaticResource AppPasswordBox}" Height="38" KeyDown="Value_KeyDown" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}"
                       FontSize="12" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click" />
                <Button Content="Continue" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
