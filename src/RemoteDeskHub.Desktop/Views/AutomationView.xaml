<UserControl x:Class="RemoteDeskHub.Desktop.Views.AutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Content="New task" Style="{StaticResource PrimaryButton}" Command="{Binding NewTaskCommand}"
                        IsEnabled="{Binding CanManage}" />
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditTaskCommand}"
                        IsEnabled="{Binding CanManage}" Margin="6,0,0,0" />
                <Button Content="Enable / disable" Style="{StaticResource GhostButton}" Command="{Binding ToggleEnabledCommand}"
                        IsEnabled="{Binding CanManage}" />
                <Button Content="Run now" Style="{StaticResource SecondaryButton}" Command="{Binding RunNowCommand}"
                        IsEnabled="{Binding CanManage}" />
                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteTaskCommand}"
                        IsEnabled="{Binding CanManage}" />
            </StackPanel>
            <Button Content="Refresh" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                          Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerType}" Width="110" />
                        <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="130" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="160" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled}" Width="75" />
                        <DataGridTextColumn Header="Last run" Binding="{Binding LastRunUtc, Converter={StaticResource UtcToLocal}}" Width="140" />
                        <DataGridTextColumn Header="Next run" Binding="{Binding NextRunUtc, Converter={StaticResource UtcToLocal}}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedTask.Name, FallbackValue=No task selected}" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedTask.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="Last result: " />
                            <Run Text="{Binding SelectedTask.LastResult, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Execution history" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                 ItemsSource="{Binding Executions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AutomationExecutionView}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TaskName}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding Status, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Succeeded, Mode=OneWay}" />
                                            <Run Text=" ok · " />
                                            <Run Text="{Binding Failed, Mode=OneWay}" />
                                            <Run Text=" failed · " />
                                            <Run Text="{Binding StartedUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Log}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxHeight="80" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Editor overlay -->
        <Border Grid.RowSpan="2" Background="#D9101218" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Automation task" Style="{StaticResource H2}" />
                        <TextBlock Text="Choose a trigger, an action and (optionally) a single target computer."
                                   Style="{StaticResource Muted}" Margin="0,3,0,14" />

                        <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                        <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                        <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                        <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Trigger" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding TriggerType}" Style="{StaticResource AppComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Action" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding ActionType}" Style="{StaticResource AppComboBox}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0" Visibility="{Binding NeedsInterval, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Interval (minutes)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Daily time (HH:mm)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsDailyTime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Daily time (HH:mm, local)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsServiceName, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Service name" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ConfigServiceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsCommand, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Command" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ConfigCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                                     Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
                            <TextBlock Text="Shell" Style="{StaticResource Caption}" Margin="0,8,0,5" />
                            <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding ConfigShell}" Style="{StaticResource AppComboBox}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Notification message" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ConfigMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding NeedsThreshold, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Free-space threshold (%)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding ConfigThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>

                        <TextBlock Text="Target computer (leave blank for all managed computers)" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                        <ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding TargetComputer}" DisplayMemberPath="DisplayName"
                                  Style="{StaticResource AppComboBox}" />

                        <CheckBox Content="Task enabled" Style="{StaticResource AppCheckBox}" IsChecked="{Binding TaskEnabled}" Margin="0,12,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Save task" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTaskCommand}" />
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelTaskCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
