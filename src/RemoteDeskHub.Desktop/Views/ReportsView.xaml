<UserControl x:Class="RemoteDeskHub.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RemoteDeskHub.Desktop.ViewModels"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Format" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Style="{StaticResource AppComboBox}"
                              Width="110" Height="34" />
                    <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="34" />
                    <TextBlock Text="To" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="34" />
                    <ComboBox ItemsSource="{Binding CustomReports}" SelectedItem="{Binding SelectedCustomReport}"
                              Style="{StaticResource AppComboBox}" Width="160" Height="34" Margin="14,0,8,0" />
                    <Button Content="Generate" Style="{StaticResource PrimaryButton}" Command="{Binding CustomReportCommand}"
                            IsEnabled="{Binding CanExport}" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" MaxWidth="300" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock Text="Network inventory" Style="{StaticResource H3}" />
                                <TextBlock Text="Computers, groups, addresses, agent state and live utilisation."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding NetworkInventoryCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,6,10">
                            <StackPanel>
                                <TextBlock Text="Hardware inventory" Style="{StaticResource H3}" />
                                <TextBlock Text="CPU, memory, storage, graphics and motherboard details."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding HardwareInventoryCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Software inventory" Style="{StaticResource H3}" />
                                <TextBlock Text="Installed applications with publisher, version and size."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding SoftwareInventoryCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,6,10">
                            <StackPanel>
                                <TextBlock Text="Alert report" Style="{StaticResource H3}" />
                                <TextBlock Text="Active, acknowledged and resolved alerts by severity."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding AlertReportCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,6,10">
                            <StackPanel>
                                <TextBlock Text="Agent health" Style="{StaticResource H3}" />
                                <TextBlock Text="Enrollment state, last heartbeat, version and certificate status."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding AgentHealthCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Audit log" Style="{StaticResource H3}" />
                                <TextBlock Text="Chronological privileged actions with actors and results."
                                           Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Content="Generate" Style="{StaticResource SecondaryButton}" Command="{Binding AuditReportCommand}"
                                        IsEnabled="{Binding CanExport}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Custom selection" Style="{StaticResource H3}" />
                            <TextBlock Text="Use the format and date controls above with any report name, including performance history. Reports are written locally to the hub exports folder and then offered as a save dialog."
                                       Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="Generated in this session" Style="{StaticResource H3}" />
                    </Grid>
                    <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                             ItemsSource="{Binding Generated}" SelectedItem="{Binding SelectedGenerated}" Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GeneratedReport}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding GeneratedText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,14">
                        <Button Content="Save again" Style="{StaticResource SecondaryButton}" Command="{Binding SaveGeneratedCommand}" />
                        <Button Content="Clear list" Style="{StaticResource GhostButton}" Command="{Binding ClearHistoryCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
