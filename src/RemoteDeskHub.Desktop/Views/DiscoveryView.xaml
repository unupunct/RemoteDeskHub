<UserControl x:Class="RemoteDeskHub.Desktop.Views.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Scan panel -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Scan mode" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox SelectedIndex="{Binding ScanModeIndex}" Style="{StaticResource AppComboBox}" Width="220" Height="34">
                            <ComboBoxItem Content="Local subnet" />
                            <ComboBoxItem Content="Address range" />
                            <ComboBoxItem Content="CIDR range" />
                        </ComboBox>
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local subnet to suggest" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet}"
                                      Style="{StaticResource AppComboBox}" Height="34" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CIDR range (e.g. 192.168.1.0/24)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding CidrText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Address range (start-end)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                                     ToolTip="Example: 192.168.1.1-192.168.1.254" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Use subnet" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <Button Content="Use detected subnet" Style="{StaticResource SecondaryButton}" Command="{Binding UseSubnetCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Timeout ms" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Concurrency" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom" MinWidth="190">
                    <Button Content="Start scan" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            IsEnabled="{Binding CanDiscover}" Height="40" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding ProgressText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                        <Button Content="Refresh results" Style="{StaticResource GhostButton}" FontSize="11"
                                HorizontalAlignment="Right" Command="{Binding RefreshCommand}" />
                    </Grid>
                    <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}" Margin="8,0,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="135" />
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="140" />
                            <DataGridTemplateColumn Header="Agent" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:DiscoveryView}">
                                        <TextBlock Text="{Binding HasAgent, Converter={StaticResource BoolToYesNo}}" FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Inventory" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:DiscoveryView}">
                                        <TextBlock Text="{Binding IsRegistered, Converter={StaticResource BoolToYesNo}}" FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenUtc, Converter={StaticResource UtcToLocal}}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding LastResultText}" Style="{StaticResource Caption}" Margin="16,0,16,12" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue=No device selected}"
                               Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedDevice.IpAddress}" Style="{StaticResource Muted}" Margin="0,3,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Operating system" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.OperatingSystem}" Style="{StaticResource Body}" />
                        <TextBlock Grid.Row="1" Text="Open services" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDevice.OpenServices}" Style="{StaticResource Body}" />
                        <TextBlock Grid.Row="2" Text="Response" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDevice.ResponseTimeMs, StringFormat='{}{0:0} ms'}" Style="{StaticResource Body}" />
                        <TextBlock Grid.Row="3" Text="Has agent" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDevice.HasAgent}" Style="{StaticResource Body}" />
                        <TextBlock Grid.Row="4" Text="First seen" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDevice.FirstSeenUtc, Converter={StaticResource UtcToLocal}}" Style="{StaticResource Body}" />
                    </Grid>

                    <TextBlock Text="Notes" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedDevice.Notes, FallbackValue=No notes}" Style="{StaticResource Muted}" Margin="0,4,0,14" />

                    <TextBlock Text="Assign to group" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding TargetGroup}" DisplayMemberPath="Name"
                              Style="{StaticResource AppComboBox}" Height="34" Margin="0,0,0,10" />

                    <CheckBox Content="Trust this computer on add" Style="{StaticResource AppCheckBox}"
                              IsChecked="{Binding TrustOnAdd}" Margin="0,0,0,12" />

                    <Button Content="Add to inventory" Style="{StaticResource PrimaryButton}" Command="{Binding AddToInventoryCommand}"
                            IsEnabled="{Binding CanDiscover}" Margin="0,0,0,8" />
                    <Button Content="Toggle trust" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleTrustCommand}"
                            IsEnabled="{Binding CanDiscover}" Margin="0,0,0,8" />
                    <Button Content="Edit notes" Style="{StaticResource SecondaryButton}" Command="{Binding EditNotesCommand}"
                            IsEnabled="{Binding CanDiscover}" Margin="0,0,0,8" />
                    <Button Content="Remove discovery record" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}"
                            IsEnabled="{Binding CanDiscover}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
