<UserControl x:Class="RemoteDeskHub.Desktop.Views.RemoteAssistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             xmlns:domain="clr-namespace:RemoteDeskHub.Core.Domain;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          Style="{StaticResource AppComboBox}" Width="235" Height="36" />
                <ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}"
                          Style="{StaticResource AppComboBox}" Width="245" Height="36" Margin="8,0,0,0" />
                <TextBox Text="{Binding ConnectionTarget, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Width="195" Height="36" Margin="8,0,0,0"
                         Visibility="{Binding RequiresConnectionTarget, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="{Binding ConnectionTargetLabel}" />
                <Button Content="Launch session" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}"
                        IsEnabled="{Binding CanLaunch}" Margin="8,0,0,0" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="Launch starts immediately by default. Every session records the operator, tool, target and time in the audit log; enable the consent policy in Settings to require a target-consent confirmation."
                       Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="Assistance targets" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding Targets.Count, StringFormat='{}{0} computers'}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                             ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Margin="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RemoteAssistanceTarget}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ComputerName}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding IpAddress, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding OperatingSystem, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Text" Value="Offline" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                        <Setter Property="Text" Value="Online" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl Style="{StaticResource AppTabControl}" ItemContainerStyle="{StaticResource AppTabItem}">
                    <TabItem Header="Session">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Launch details" Style="{StaticResource H3}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}" Padding="12">
                                <TextBlock Text="{Binding LaunchInfo}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                            </Border>
                            <Button Content="Copy details" Style="{StaticResource SecondaryButton}" Command="{Binding CopyLaunchInfoCommand}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left" />

                            <TextBlock Text="Active and recent sessions" Style="{StaticResource H3}" Margin="0,18,0,8" />
                            <ListBox Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                     ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSession}" MaxHeight="240">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type domain:RemoteSession}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ComputerName}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Tool, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Status, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding StartedUtc, Mode=OneWay, Converter={StaticResource UtcToLocal}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Mark session ended" Style="{StaticResource GhostButton}" Command="{Binding EndSessionCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Profiles">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <ListBox Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                         ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:RemoteAssistanceProfile}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="{Binding Tool, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Arguments, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewProfileCommand}" />
                                    <Button Content="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditProfileCommand}" />
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteProfileCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource SurfaceAltBrush}"
                                    Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Profile" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                                    <TextBlock Text="Tool" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                                    <ComboBox ItemsSource="{Binding ProfileTools}" SelectedItem="{Binding ProfileTool}"
                                              Style="{StaticResource AppComboBox}" />
                                    <TextBlock Text="Extra arguments" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding ProfileArguments, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                                    <TextBlock Text="Operator instructions" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                                    <TextBox Text="{Binding ProfileInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                                             Height="60" AcceptsReturn="True" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}" />
                                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelProfileCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
