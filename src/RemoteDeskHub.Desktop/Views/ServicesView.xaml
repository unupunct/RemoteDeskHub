<UserControl x:Class="RemoteDeskHub.Desktop.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:proto="clr-namespace:RemoteDeskHub.Shared.Protocol;assembly=RemoteDeskHub.Shared"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}" DisplayMemberPath="DisplayName"
                          Style="{StaticResource AppComboBox}" Width="250" Height="36" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                         Width="240" Margin="8,0,0,0" ToolTip="Filter by service name or display name" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding FilteredServices}"
                          SelectedItem="{Binding SelectedService}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Service name" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Startup" Binding="{Binding StartupType}" Width="110" />
                        <DataGridTemplateColumn Header="Critical" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type proto:RemoteServiceDto}">
                                    <TextBlock Text="{Binding IsCritical, Converter={StaticResource BoolToYesNo}}" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedService.DisplayName, FallbackValue=No service selected}"
                                   Style="{StaticResource H2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedService.Name}" Style="{StaticResource Muted}" Margin="0,3,0,12" />
                        <TextBlock Text="{Binding SelectedService.Description}" Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   MaxHeight="90" />

                        <TextBlock Text="Service control" Style="{StaticResource H3}" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Start" Style="{StaticResource SecondaryButton}" Command="{Binding StartCommand}"
                                    IsEnabled="{Binding CanManage}" Margin="0,0,6,6" />
                            <Button Content="Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}"
                                    IsEnabled="{Binding CanManage}" Margin="0,0,6,6" />
                            <Button Content="Restart" Style="{StaticResource SecondaryButton}" Command="{Binding RestartCommand}"
                                    IsEnabled="{Binding CanManage}" Margin="0,0,6,6" />
                            <Button Content="Pause" Style="{StaticResource GhostButton}" Command="{Binding PauseCommand}"
                                    IsEnabled="{Binding CanManage}" Margin="0,0,6,6" />
                            <Button Content="Resume" Style="{StaticResource GhostButton}" Command="{Binding ResumeCommand}"
                                    IsEnabled="{Binding CanManage}" Margin="0,0,0,6" />
                        </WrapPanel>

                        <TextBlock Text="Startup type" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                        <ComboBox ItemsSource="{Binding StartupTypes}" SelectedItem="{Binding SelectedStartupType}"
                                  Style="{StaticResource AppComboBox}" Height="34" />
                        <Button Content="Apply startup type" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyStartupTypeCommand}"
                                IsEnabled="{Binding CanManage}" Margin="0,8,0,0" />

                        <TextBlock Text="Dependency chain" Style="{StaticResource H3}" Margin="0,16,0,8" />
                        <ItemsControl ItemsSource="{Binding Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type proto:RemoteServiceDto}">
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No dependent services." Style="{StaticResource Caption}"
                                   Visibility="{Binding Dependencies.Count, Converter={StaticResource ZeroToCollapsed}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Text="Stopping critical services requires explicit confirmation. All service changes are audited." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
