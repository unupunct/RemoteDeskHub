<UserControl x:Class="RemoteDeskHub.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:RemoteDeskHub.Core.Domain;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="New account" Style="{StaticResource H3}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                             Width="200" ToolTip="User name" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Style="{StaticResource AppComboBox}"
                              Width="150" Margin="8,0,0,0" />
                    <Button Content="Create user" Style="{StaticResource PrimaryButton}" Command="{Binding CreateUserCommand}"
                            IsEnabled="{Binding CanManage}" Margin="8,0,0,0" />
                    <Button Content="Change my password" Style="{StaticResource SecondaryButton}" Command="{Binding ChangeOwnPasswordCommand}"
                            Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User name" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140" />
                        <DataGridTextColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="90" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                        <DataGridTextColumn Header="Last sign-in" Binding="{Binding LastLoginUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                        <DataGridTextColumn Header="Failed attempts" Binding="{Binding FailedLoginCount}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedUser.Username, FallbackValue=No account selected}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding SelectedUser.Role}" Style="{StaticResource Muted}" Margin="0,3,0,14" />

                    <TextBlock Text="Role" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource AppComboBox}"
                              Height="34" />
                    <Button Content="Apply role" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyRoleCommand}"
                            IsEnabled="{Binding CanManage}" Margin="0,8,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />

                    <Button Content="Enable / disable account" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEnabledCommand}"
                            IsEnabled="{Binding CanManage}" Margin="0,0,0,6" />
                    <Button Content="Reset password" Style="{StaticResource SecondaryButton}" Command="{Binding ResetPasswordCommand}"
                            IsEnabled="{Binding CanManage}" Margin="0,0,0,6" />
                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />
                    <TextBlock Text="Role reference" Style="{StaticResource H3}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Administrator — " FontWeight="SemiBold" />
                        <Run Text="full control including security, users, settings and backups." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="Operator — " FontWeight="SemiBold" />
                        <Run Text="commands, processes, services, files, assistance, automation and alerts." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                        <Run Text="Viewer — " FontWeight="SemiBold" />
                        <Run Text="read-only dashboards, inventory, monitoring, reports and exports." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
