<UserControl x:Class="RemoteDeskHub.Desktop.Views.FileTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:proto="clr-namespace:RemoteDeskHub.Shared.Protocol;assembly=RemoteDeskHub.Shared"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <TabControl Style="{StaticResource AppTabControl}" ItemContainerStyle="{StaticResource AppTabItem}">
            <TabItem Header="Remote files">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}" DisplayMemberPath="DisplayName"
                                      Style="{StaticResource AppComboBox}" Width="240" Height="36" />
                            <ComboBox ItemsSource="{Binding AllowedRoots}" SelectedItem="{Binding SelectedRoot}" Style="{StaticResource AppComboBox}"
                                      Width="220" Height="36" Margin="8,0,0,0" ToolTip="Permitted file roots reported by the agent" />
                            <Button Content="Go" Style="{StaticResource SecondaryButton}" Command="{Binding OpenRootCommand}" Margin="6,0,0,0" />
                            <Button Content="Up" Style="{StaticResource GhostButton}" Command="{Binding GoUpCommand}" />
                            <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Upload" Style="{StaticResource PrimaryButton}" Command="{Binding UploadCommand}" IsEnabled="{Binding CanTransfer}" />
                            <Button Content="Download" Style="{StaticResource SecondaryButton}" Command="{Binding DownloadCommand}"
                                    IsEnabled="{Binding CanTransfer}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Mono}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,180,0" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="FilesGrid" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Entries}"
                                      SelectedItem="{Binding SelectedEntry}" Margin="8" MouseDoubleClick="Files_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Name" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type proto:FileEntryDto}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource BytesToText}}" Width="100" />
                                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                                    <DataGridTextColumn Header="Attributes" Binding="{Binding Attributes}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <TabControl Style="{StaticResource AppTabControl}" ItemContainerStyle="{StaticResource AppTabItem}">
                                <TabItem Header="Actions">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding SelectedEntry.Name, FallbackValue=No item selected}" Style="{StaticResource H3}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedEntry.FullPath}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,12" />

                                        <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenEntryCommand}" Margin="0,0,0,6" />
                                        <Button Content="New folder" Style="{StaticResource SecondaryButton}" Command="{Binding NewFolderCommand}"
                                                IsEnabled="{Binding CanTransfer}" Margin="0,0,0,6" />
                                        <Button Content="Rename" Style="{StaticResource SecondaryButton}" Command="{Binding RenameCommand}"
                                                IsEnabled="{Binding CanTransfer}" Margin="0,0,0,6" />
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                                                IsEnabled="{Binding CanDelete}" Margin="0,0,0,12" />

                                        <TextBlock Text="Transfer" Style="{StaticResource H3}" Margin="0,8,0,8" />
                                        <ProgressBar Value="{Binding TransferPercent}" Maximum="100" Height="6" />
                                        <TextBlock Text="{Binding TransferStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <Button Content="Cancel transfer" Style="{StaticResource GhostButton}" Command="{Binding CancelTransferCommand}"
                                                Visibility="{Binding IsTransferring, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="History">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ListBox Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                                 ItemsSource="{Binding Transfers}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:FileTransferView}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding LocalPath}" FontSize="12" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource Caption}">
                                                            <Run Text="{Binding Direction, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Status, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToText}}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding StartedUtc, Converter={StaticResource UtcToLocal}}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Grid.Row="1" Content="Refresh history" Style="{StaticResource GhostButton}"
                                                Command="{Binding RefreshHistoryCommand}" Margin="0,8,0,0" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Shared folder">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Shared folder" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10">
                                    A dedicated sync root that is separate from the permitted remote file-transfer roots. Files placed in
                                    <Run Text="{Binding SharedStatus.RootPath, Mode=OneWay, TargetNullValue=C:\zzz}" FontFamily="Cascadia Mono, Consolas" />
                                    on the hub or on any managed computer are copied to every online computer. The hub checks every 15 seconds.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Folder" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SharedStatus.RootPath, TargetNullValue=C:\zzz}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="Open folder" Style="{StaticResource GhostButton}" Command="{Binding OpenSharedFolderCommand}" />
                                    <Button Content="Add files" Style="{StaticResource PrimaryButton}" Command="{Binding AddSharedFilesCommand}"
                                            IsEnabled="{Binding CanManageSharedFolder}" Margin="8,0,0,0" />
                                    <Button Content="Add folder" Style="{StaticResource SecondaryButton}" Command="{Binding AddSharedFolderCommand}"
                                            IsEnabled="{Binding CanManageSharedFolder}" Margin="6,0,0,0" />
                                    <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshSharedFolderCommand}" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SharedEnabledText}" Style="{StaticResource H3}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SharedLastSyncText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Central files" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SharedFileCountText}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total size" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SharedTotalSizeText}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Online peers" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SharedAgentCountText}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Conflict copies" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SharedConflictCountText}" Style="{StaticResource H2}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Last check" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SharedLastSyncText}" Style="{StaticResource H3}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SharedStatusMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,2,10" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="2,0,0,8">
                                        <TextBlock Text="Hub copy" Style="{StaticResource H3}" VerticalAlignment="Center" />
                                        <Button Content="Open file location" Style="{StaticResource GhostButton}"
                                                Command="{Binding OpenSharedFileLocationCommand}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding SharedFiles}"
                                              SelectedItem="{Binding SelectedSharedFile}" IsReadOnly="True" AutoGenerateColumns="False"
                                              RowHeight="34" Grid.Row="1">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="150" />
                                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedUtc, Converter={StaticResource UtcToLocal}}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Agents" Style="{StaticResource H3}" Margin="2,0,0,8" />
                                    <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                             ItemsSource="{Binding SharedAgents}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SharedFolderAgentView}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ComputerName}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding OnlineText}" Style="{StaticResource Caption}" />
                                                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}">
                                                        <Run Text="{Binding FileCount, Mode=OneWay}" />
                                                        <Run Text=" files · last scan " />
                                                        <Run Text="{Binding ObservedText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
