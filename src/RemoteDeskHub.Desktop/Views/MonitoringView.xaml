<UserControl x:Class="RemoteDeskHub.Desktop.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RemoteDeskHub.Desktop.Controls"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}" DisplayMemberPath="DisplayName"
                          Style="{StaticResource AppComboBox}" Width="260" Height="36" />
                <ComboBox ItemsSource="{Binding RangeOptions}" SelectedIndex="{Binding RangeHoursIndex}"
                          Style="{StaticResource AppComboBox}" Width="130" Height="36" Margin="8,0,0,0" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                <Button Content="Export history" Style="{StaticResource GhostButton}" Command="{Binding ExportHistoryCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Purge old metrics" Style="{StaticResource DangerButton}" Command="{Binding PurgeOldMetricsCommand}"
                        IsEnabled="{Binding CanPurge}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU %" Style="{StaticResource H3}" Margin="0,0,0,6" />
                        <controls:LineChart Grid.Row="1" Series="{Binding CpuSeries}" Maximum="100"
                                            EmptyText="No CPU samples for this period." />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Memory %" Style="{StaticResource H3}" Margin="0,0,0,6" />
                        <controls:LineChart Grid.Row="1" Series="{Binding MemorySeries}" Maximum="100"
                                            EmptyText="No memory samples for this period." />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Disk %" Style="{StaticResource H3}" Margin="0,0,0,6" />
                            <controls:LineChart Height="150" Series="{Binding DiskSeries}" Maximum="100"
                                                EmptyText="No disk samples." />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Live agent metrics" Style="{StaticResource H3}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="Memory" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="Disk free" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="1" Text="{Binding LiveMetrics.CpuPercent, Converter={StaticResource PercentToText}, FallbackValue=—}" Style="{StaticResource H2}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LiveMetrics.MemoryPercent, Converter={StaticResource PercentToText}, FallbackValue=—}" Style="{StaticResource H2}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LiveMetrics.DiskFreeBytes, Converter={StaticResource BytesToText}, FallbackValue=—}" Style="{StaticResource H2}" />
                                <TextBlock Grid.Row="2" Text="{Binding LiveMetrics.UptimeSeconds, StringFormat='Uptime {0}s'}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LiveMetrics.ProcessCount, StringFormat='{}{0} processes'}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LiveMetrics.ServiceCount, StringFormat='{}{0} services'}" Style="{StaticResource Caption}" />
                            </Grid>
                            <TextBlock Text="{Binding LatestSampleText}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Alerts and rules -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <TabControl Style="{StaticResource AppTabControl}" ItemContainerStyle="{StaticResource AppTabItem}">
                    <TabItem Header="Alerts">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox Content="Active alerts only" Style="{StaticResource AppCheckBox}"
                                      IsChecked="{Binding ActiveAlertsOnly}" Margin="0,8,0,8" />
                            <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                     ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AlertView}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                                         Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CreatedUtc, Converter={StaticResource UtcToLocal}}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Acknowledge" Style="{StaticResource SecondaryButton}" Command="{Binding AcknowledgeAlertCommand}"
                                        IsEnabled="{Binding CanManageAlerts}" />
                                <Button Content="Resolve" Style="{StaticResource GhostButton}" Command="{Binding ResolveAlertCommand}"
                                        IsEnabled="{Binding CanManageAlerts}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Rules">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Style="{StaticResource AppListBox}" ItemContainerStyle="{StaticResource AppListBoxItem}"
                                     ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AlertRuleView}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding MetricType, Mode=OneWay}" />
                                                <Run Text=" · threshold " />
                                                <Run Text="{Binding Threshold, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Severity, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Enabled, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="New" Style="{StaticResource SecondaryButton}" Command="{Binding NewRuleCommand}"
                                        IsEnabled="{Binding CanManageAlerts}" />
                                <Button Content="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditRuleCommand}"
                                        IsEnabled="{Binding CanManageAlerts}" />
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteRuleCommand}"
                                        IsEnabled="{Binding CanManageAlerts}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Rule editor overlay -->
        <Border Grid.RowSpan="2" Background="#D9101218" Visibility="{Binding IsRuleEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Alert rule" Style="{StaticResource H2}" />
                    <TextBlock Text="Rules are evaluated after each metrics batch." Style="{StaticResource Muted}" Margin="0,3,0,14" />

                    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Metric" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AlertMetrics}" SelectedItem="{Binding RuleMetric}"
                                      Style="{StaticResource AppComboBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Severity" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding RuleSeverity}"
                                      Style="{StaticResource AppComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Threshold" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding RuleThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cooldown (minutes)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding RuleCooldownMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Rule enabled" Style="{StaticResource AppCheckBox}" IsChecked="{Binding RuleEnabled}" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Save rule" Style="{StaticResource PrimaryButton}" Command="{Binding SaveRuleCommand}" />
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelRuleCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
