<Window x:Class="RemoteDeskHub.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in · RemoteDesk Hub"
        Width="1000" Height="640" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="/Assets/RemoteDeskHub.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid Margin="44,46,44,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="R" FontSize="23" FontWeight="Bold" Foreground="#0B1220"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RemoteDesk" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="HUB CONSOLE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Your LAN, under control." Style="{StaticResource H1}" FontSize="30" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="13" LineHeight="21"
                               Text="Discover, monitor and administer the Windows computers on your local network from one secure console." />

                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Text="&#xE72E;  Mutual TLS for every agent" FontFamily="Segoe MDL2 Assets, Segoe UI"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="&#xE9D9;  Live performance and health alerts" FontFamily="Segoe MDL2 Assets, Segoe UI"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="&#xE81C;  Tamper-evident audit trail" FontFamily="Segoe MDL2 Assets, Segoe UI"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="&#xE8D7;  Approval-gated agent enrollment" FontFamily="Segoe MDL2 Assets, Segoe UI"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />
                    <TextBlock x:Name="EndpointText" Style="{StaticResource Caption}" Text="Hub starting…" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="LAN-only management · no cloud dependency" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sign-in form -->
        <Grid Grid.Column="1" Margin="64,0">
            <StackPanel VerticalAlignment="Center" MaxWidth="380">
                <TextBlock Text="Sign in" Style="{StaticResource H1}" />
                <TextBlock Text="Use an administrator or operator account to open the console."
                           Style="{StaticResource Muted}" Margin="0,6,0,28" />

                <TextBlock Text="User name" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <TextBox x:Name="UserNameBox" Style="{StaticResource AppTextBox}" Height="40"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBox}" Height="40"
                             VerticalContentAlignment="Center" KeyDown="Password_KeyDown" />

                <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#2A1519"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6"
                        Padding="10,8" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                        Height="42" Margin="0,24,0,0" Click="SignIn_Click" IsDefault="True" />

                <Button Content="Exit" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                        Click="Exit_Click" HorizontalAlignment="Center" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,26,0,0" TextAlignment="Center"
                           Text="Accounts lock for 5 minutes after 5 failed attempts. All sign-in activity is audited." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
