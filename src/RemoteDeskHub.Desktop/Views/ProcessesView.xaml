<UserControl x:Class="RemoteDeskHub.Desktop.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:proto="clr-namespace:RemoteDeskHub.Shared.Protocol;assembly=RemoteDeskHub.Shared"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}" DisplayMemberPath="DisplayName"
                          Style="{StaticResource AppComboBox}" Width="250" Height="36" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                         Width="220" Margin="8,0,0,0" ToolTip="Filter by process name, PID or user" />
                <CheckBox Content="Show protected" Style="{StaticResource AppCheckBox}" IsChecked="{Binding ShowProtected}"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                <Button Content="Export CSV" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}" />
            </StackPanel>
            <Button Content="Terminate process" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                    Command="{Binding TerminateCommand}" IsEnabled="{Binding CanManage}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="16,14,16,8" />
                <DataGrid Grid.Row="1" Style="{StaticResource AppDataGrid}" ItemsSource="{Binding FilteredProcesses}"
                          SelectedItem="{Binding SelectedProcess}" Margin="8,0,8,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                        <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.#}}" Width="80" />
                        <DataGridTextColumn Header="Working set" Binding="{Binding WorkingSetBytes, Converter={StaticResource BytesToText}}" Width="110" />
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="180" />
                        <DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="75" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTemplateColumn Header="Protected" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type proto:RemoteProcessDto}">
                                    <TextBlock Text="{Binding IsProtected, Converter={StaticResource BoolToYesNo}}" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="16,0,16,12"
                           Text="Protected system processes cannot be terminated. Every termination requires explicit confirmation and is audited." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
