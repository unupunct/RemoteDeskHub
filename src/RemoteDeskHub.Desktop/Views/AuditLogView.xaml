<UserControl x:Class="RemoteDeskHub.Desktop.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="34" />
                <TextBlock Text="To" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="34" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                         Width="240" Margin="10,0,0,0" ToolTip="Search actor, operation, computer or details" />
                <Button Content="Search" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Verify hash chain" Style="{StaticResource SecondaryButton}" Command="{Binding VerifyChainCommand}" />
                <Button Content="Export" Style="{StaticResource GhostButton}" Command="{Binding ExportCommand}" />
                <Button Content="Purge old" Style="{StaticResource DangerButton}" Command="{Binding PurgeOldCommand}"
                        IsEnabled="{Binding CanPurge}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <TextBlock Text="{Binding ChainStatus}" TextWrapping="Wrap" Margin="0,0,100,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChainValid}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChainValid}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid Style="{StaticResource AppDataGrid}" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampUtc, Converter={StaticResource UtcToLocal}}" Width="145" />
                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="130" />
                    <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="220" />
                    <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="150" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" />
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat='{}{0} ms'}" Width="90" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="IP address: " />
                    <Run Text="{Binding SelectedEntry.IpAddress, Mode=OneWay, FallbackValue=local}" />
                    <Run Text=" · Error: " />
                    <Run Text="{Binding SelectedEntry.Error, Mode=OneWay, FallbackValue=none}" />
                </TextBlock>
                <TextBlock Text="{Binding SelectedEntry.Details}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
