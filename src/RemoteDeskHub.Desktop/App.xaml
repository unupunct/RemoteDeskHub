<Application x:Class="RemoteDeskHub.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RemoteDeskHub.Desktop.Converters"
             xmlns:models="clr-namespace:RemoteDeskHub.Core.Models;assembly=RemoteDeskHub.Core"
             xmlns:shared="clr-namespace:RemoteDeskHub.Shared;assembly=RemoteDeskHub.Shared"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:StringToVisibilityConverter x:Key="EmptyToCollapsed" Invert="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:CountToVisibilityConverter x:Key="ZeroToCollapsed" Invert="True" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
            <conv:BytesToTextConverter x:Key="BytesToText" />
            <conv:PercentToTextConverter x:Key="PercentToText" />
            <conv:UtcToLocalConverter x:Key="UtcToLocal" />
            <conv:BoolToBrushConverter x:Key="BoolToBrush" />
            <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />

            <!-- Implicit templates keep combo boxes readable while using DisplayMemberPath. -->
            <DataTemplate DataType="{x:Type models:ComputerSummary}">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:GroupView}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type models:RemoteAssistanceTarget}">
                <TextBlock Text="{Binding ComputerName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type shared:RemoteToolDefinition}">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
